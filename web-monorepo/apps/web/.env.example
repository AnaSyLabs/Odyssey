# Arkiv (Rabdi testnet). Access key: https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
# Gateway wallet: owns every sample/device entity and pays gas in tGLM (faucet: https://hub.arkiv.network/faucet)
ARKIV_PRIVATE_KEY=

# 0G Galileo wallet: stores payloads over 96 KiB on 0G Storage, and owns the subscriptions contract
# (sets prices, publishes reward roots). Needs 0G testnet tokens (https://faucet.0g.ai)
OG_PRIVATE_KEY=
# OG_RPC_URL=https://evmrpc-testnet.0g.ai
# OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# World ID (developer.world.org): app, RP id and RP signing key for /enroll. Create an action named "register-device".
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# staging = test with simulator.worldcoin.org; production (default) = the real World App
WORLD_ENVIRONMENT=staging

# Shared secret for an external World ID registrar -> POST /api/devices
REGISTRAR_TOKEN=
# Secret for GET /api/cron/extend (Vercel cron sends it as a Bearer token)
CRON_SECRET=

# Retention: extend samples expiring within N days, keep 1 per device per geohash cell per window
# EXTEND_WITHIN_DAYS=7
# THIN_GEOHASH_PRECISION=7
# THIN_WINDOW_SECONDS=3600
# MAX_UPLOAD_BYTES=10485760

# Device simulator (scripts/simulate-device.ts)
# GATEWAY_URL=http://localhost:3000
# DEVICE_PRIVATE_KEY=0x
# SIM_PAYOUT_ADDRESS=0x            # wallet that receives the simulated device's contributor rewards

# Lab ingest (scripts/lab-ingest.ts), normally run by the AI lab with its own .env
# ODSY_GATEWAY_ADDRESS=0x          # the only trusted writer: address of ARKIV_PRIVATE_KEY
# GATEWAY_URL=http://localhost:3000
# LAB_PRIVATE_KEY=0x               # the wallet that paid for the subscription
# LAB_DATASETS=0x...,0x...         # dataset keys to pull
# LAB_MODE=all                     # all = every sample; thinned = only the one per group the gateway keeps
# LAB_THIN_GRACE_SECONDS=3600      # thinned: wait this long after a window closes for late uploads
# LAB_OUT_DIR=lab-data

# App: wallet sign-in, encryption, dataset payments
# Encrypts every sample payload. Generate once (openssl rand -hex 32), BACK IT UP, never change it.
DATA_KEY=
# Signs session cookies (openssl rand -hex 32). Changing it signs everyone out.
SESSION_SECRET=
# Comma-separated root admins: they can create datasets, see all transactions and add more admins on /admin.
# Root admins can't be removed from the app, so keep at least one here.
ADMIN_ADDRESSES=
# OdsySubscriptions on 0G Galileo (contracts/), deployed with OG_PRIVATE_KEY, and the block it was deployed in
SUBSCRIPTIONS_ADDRESS=
SUBSCRIPTIONS_FROM_BLOCK=
# ConsensusRegistry on 0G Galileo (contracts/), operator = the OG_PRIVATE_KEY wallet. Optional: unset means no bans.
CONSENSUS_ADDRESS=
