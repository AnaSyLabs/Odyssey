# Who controls the contract (lifts bans, adds validators). Use a multisig in production.
ADMIN=0x0000000000000000000000000000000000000000
# The gateway wallet: creates datasets, submits tiles, raises alerts.
OPERATOR=0x0000000000000000000000000000000000000000

# Rules for every dataset. Fixed at deploy; redeploy to change them.
QUORUM_BPS=6667          # share of checked samples that must pass (6667 = two thirds)
COMMITTEE_SIZE=5         # validator votes needed to finish a tile
MIN_SAMPLE_RATE_BPS=100  # lowest spot-check rate a dataset may choose (100 = 1%)
MIN_CHECKS=3             # every tile gets at least this many checks
STRIKE_LIMIT=2           # provable alerts before a World ID is banned

RPC_URL=
